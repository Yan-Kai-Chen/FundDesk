# Only the source layout below belongs in Git. Runtime data stays local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/SECURITY.md
!/CONTRIBUTING.md
!/THIRD_PARTY_NOTICES.md
!/LICENSE
!/.github/
!/src/
!/tests/
!/tools/
!/config/
!/input/
!/data/
!/docs/

.DS_Store
__pycache__/
*.py[cod]
.venv/
venv/
node_modules/
dist/
build/
.pytest_cache/
*.tsbuildinfo
.coverage
coverage/
.env
.env.*
!.env.example
*.db
*.db-*
*.sqlite*
*.log
*.p12
*.pfx
*.pem
*.key
*.zip
*.tar
*.tgz
*.7z
*.app/

